v2/data-research/
v2/data-dump/

# Vite
.vite/
.vercel
.env*.local

# Artefactos de diagnostico contra produccion (nunca se commitean)
qa_*.json
qa_*.txt
qa_*.bin

# scripts temporales de auditoría web (no son código de producto)
v2/web/scripts-tmp/

# ─── Limpieza de repo 23-sep-2026 ────────────────────────────────────────
# Cachés de gestores de paquetes y de Python
.pnpm-store/
**/.pnpm-store/
**/__pycache__/
*.pyc

# Exportaciones de sesiones de agentes y temporales
_claude_export/
**/_claude_export/
v2/tmp/
v2/**/tmp/

# Estado local de la CLI de Supabase (no es código)
v2/supabase/.temp/

# Documentos privados sueltos en la raíz de v2 (contratos, NDA, hojas, fotos)
v2/*.docx
v2/*.xlsx
v2/*.jpeg
v2/*.jpg
v2/ig.html
v2/safari.html
v2/erasmus-fundeun/

# Artefactos de verificación que generan los agentes y los scripts de test
# (se regeneran; algunos contienen datos de producción)
v2/docs/**/*backup*.json
v2/docs/**/production*.json
v2/docs/**/database-tests.json
v2/docs/**/*.png

# Salida generada de marketing (las fuentes build-*.mjs, render-*.mjs y las
# plantillas .html sí se versionan; los assets de entrada también)
v2/marketing/**/*.pdf
v2/marketing/**/*.png
!v2/marketing/**/assets/
!v2/marketing/**/assets/**

# Claves y credenciales de firma/servicio (nunca al repo)
*.pem
*.p8
*.p12
*.jks
*.keystore
google-services.json
GoogleService-Info.plist
