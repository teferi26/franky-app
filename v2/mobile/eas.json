{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "beta-demo": {
      "extends": "production",
      "distribution": "store",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_NATIVE_BILLING_ENABLED": "false"
      }
    },
    "beta-demo-apk": {
      "extends": "beta-demo",
      "distribution": "internal",
      "autoIncrement": false,
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "_comentarioApple": "EXPO_PUBLIC_APPLE_AUTH enciende el botón 'Continuar con Apple' (obligatorio de facto para pasar la revisión de la App Store cuando hay login de Google, guía 4.8). REQUISITO PREVIO: habilitar el provider Apple en Supabase (Authentication → Providers → Apple) con es.franky.app como Client ID. Si aún no está hecho, pon '0' y el botón no se pinta: mejor sin botón que con un login roto delante del revisor.",
        "EXPO_PUBLIC_APPLE_AUTH": "1"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6794608974"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "testing": {
      "ios": {
        "ascAppId": "6794608974"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
