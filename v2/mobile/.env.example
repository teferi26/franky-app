# =====================================================
# Franky móvil (Expo): variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# Las EXPO_PUBLIC_* se incrustan en el bundle de la app: NUNCA pongas secretos.
# En builds EAS, los valores por perfil viven en eas.json (env) o en los
# secretos de EAS.
# =====================================================

# --- Supabase (clave anónima, pública por diseño) ---
EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Observabilidad ---
EXPO_PUBLIC_SENTRY_DSN=

# --- Login con Apple ---
# "1" pinta el botón "Continuar con Apple". Requiere el provider Apple
# habilitado en Supabase; si no, déjalo en "0".
EXPO_PUBLIC_APPLE_AUTH=0

# --- Compras in-app (RevenueCat) ---
# "true" activa el cobro nativo; con "false" la app no ofrece compras.
EXPO_PUBLIC_NATIVE_BILLING_ENABLED=false
# Claves públicas del SDK de RevenueCat (appl_... / goog_...).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Solo en build (app.config.js), no llega a la app ---
# Ruta al google-services.json de Firebase para builds Android.
GOOGLE_SERVICES_JSON=
# Clave de Google Maps para Android (restringida al paquete y la firma).
GOOGLE_MAPS_ANDROID_API_KEY=
