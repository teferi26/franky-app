# =====================================================
# Franky web: variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# La lista canónica con validación vive en src/lib/env.ts.
# NUNCA commitees .env.local (ya está en .gitignore).
# =====================================================

# --- Públicas (van al bundle del navegador, sin secretos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=
# URL canónica del sitio (enlaces de emails de verificación). Si falta se usa
# VERCEL_URL y, en último caso, https://franky.es.
NEXT_PUBLIC_SITE_URL=https://franky.es
# Versión que se adjunta a los eventos de analítica (opcional).
NEXT_PUBLIC_APP_VERSION=
# "1" muestra el botón "Continuar con Apple" en /login.
NEXT_PUBLIC_APPLE_ENABLED=
# Perfiles de redes sociales (footer y enlaces de marca). Vacío = se oculta.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Titular del servicio (aviso legal y privacidad; solo servidor) ---
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_NIF=
LEGAL_ENTITY_ADDRESS=

# --- Supabase (solo servidor) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook separado para el endpoint de Connect (/api/stripe/connect/webhook)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Price IDs de los productos
STRIPE_HOUSING_PRICE_ID=
STRIPE_LEISURE_PRICE_ID=
STRIPE_OWNER_MONTHLY_PRICE_ID=
STRIPE_OWNER_QUARTERLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
# Plan Ocio anual (el mensual es STRIPE_LEISURE_PRICE_ID).
STRIPE_LEISURE_YEARLY_PRICE_ID=
# Portal de cliente de Stripe: ID de la configuración (bpc_...). Opcional.
STRIPE_PORTAL_CONFIGURATION_ID=
# Tasa de Stripe que se suma a la comisión (defaults en src/lib/pricing.ts).
# La versión NEXT_PUBLIC_ tiene prioridad y se usa en el desglose del cliente.
STRIPE_FEE_PCT=
STRIPE_FEE_FIXED_CENTS=
NEXT_PUBLIC_STRIPE_FEE_PCT=
NEXT_PUBLIC_STRIPE_FEE_FIXED_CENTS=
# Comisiones del marketplace en % (defaults en src/lib/pricing.ts: 10/5/8)
FEE_VISIT_PCT=
FEE_RENT_PCT=
FEE_TICKET_PCT=
# Mismo % que FEE_TICKET_PCT pero visible en el cliente (desglose del
# formulario de crear evento). Mantener ambos sincronizados.
NEXT_PUBLIC_FEE_TICKET_PCT=

# --- Pisos: cobro diferido (primer interesado) ---
# Ambos flags a "true" y los tres price IDs rellenos para activarlo.
HOUSING_DEFERRED_BILLING_READY=false
HOUSING_FIRST_INTEREST_ENABLED=false
STRIPE_HOUSING_DEFERRED_LISTING_PRICE_ID=
STRIPE_HOUSING_DEFERRED_MONTHLY_PRICE_ID=
STRIPE_HOUSING_DEFERRED_QUARTERLY_PRICE_ID=

# --- Origin (pagos de comercios en cuenta Stripe separada) ---
ORIGIN_STRIPE_SECRET_KEY=
ORIGIN_STRIPE_WEBHOOK_SECRET=
# Bearer compartido con Origin para /api/partners/origin/*.
ORIGIN_PARTNER_SECRET=

# --- Suscripciones nativas (RevenueCat, compras in-app de iOS/Android) ---
REVENUECAT_SECRET_API_KEY=
# App IDs de RevenueCat aceptados por el webhook, separados por comas.
REVENUECAT_APP_IDS=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# --- Organizaciones (SaaS de espacios) ---
ORGANIZATION_BILLING_CHECKOUT_ENABLED=false

# --- Franky Card ---
FRANKY_CARD_CHECKOUT_ENABLED=false
FRANKY_CARD_APPLE_WALLET_ENABLED=false
FRANKY_CARD_GOOGLE_WALLET_ENABLED=false
# Apple Wallet (.pkpass). Los PEM admiten \n escapados en una sola línea.
CARD_APPLE_PASS_TYPE_ID=
CARD_APPLE_TEAM_ID=
CARD_APPLE_WWDR_CERT=
CARD_APPLE_SIGNER_CERT=
CARD_APPLE_SIGNER_KEY=
CARD_APPLE_SIGNER_PASSPHRASE=
# Google Wallet (cuenta de servicio).
CARD_GOOGLE_ISSUER_ID=
CARD_GOOGLE_CLASS_ID=
CARD_GOOGLE_CLIENT_EMAIL=
CARD_GOOGLE_PRIVATE_KEY=

# --- IA y email ---
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
# Paid assistant: shared daily reservations, then automatic basic navigation.
DEEPSEEK_ENABLED=true
DEEPSEEK_DAILY_CALL_LIMIT=1000
DEEPSEEK_USER_DAILY_CALL_LIMIT=30
RESEND_API_KEY=
EMAIL_FROM=
# Secreto compartido con el trigger dispatch_email de Postgres
NOTIFY_EMAIL_SECRET=
# Vercel Cron Jobs (facturas mensuales): Vercel lo manda como Bearer en cada
# invocación de /api/cron/*. Genera uno aleatorio largo y ponlo en Vercel.
CRON_SECRET=

# --- Anti-abuso ---
# (Cloudflare Turnstile se retiró en jul-2026: TURNSTILE_* ya no se leen.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Apps móviles: enlaces que abren la app instalada ---
# Team ID de Apple (10 caracteres, developer.apple.com → Membership details).
# Sin él, /.well-known/apple-app-site-association se sirve vacío y NINGÚN
# enlace de franky.es abre la app en iOS (universal links).
APPLE_TEAM_ID=
# Solo si algún día cambia el bundle id de la app (hoy es.franky.app).
APPLE_BUNDLE_ID=
# Huella SHA-256 de la firma de la app Android, en formato AA:BB:...:FF
# (npx eas credentials → Android, o Play Console → App signing). Admite varias
# separadas por comas (Play App Signing + upload). Sin ella, los App Links de
# Android no se verifican.
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=
# Server-only Apple account lifecycle. Never use NEXT_PUBLIC_/EXPO_PUBLIC_.
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=

# --- Las pone la plataforma (no hace falta definirlas) ---
# NODE_ENV, VERCEL_ENV, VERCEL_URL
# Solo tests: GOOGLE_SERVICES_JSON (config de la app móvil),
# RUN_LIVE_MODERATION_CHECK=1 (activa la prueba real de moderación).
